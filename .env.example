# Only keys with no code default live here. Copy to .env and fill in.
# .env is gitignored and must never be committed — the remote is public.

# --- Models ------------------------------------------------------------

# Every LLM role goes through OpenRouter. No direct-provider path exists.
OPENROUTER_API_KEY=

# Per-role model names, temperature, max tokens, timeout, and confidence
# threshold live in config/models.yaml (task §8), not here — this project
# follows that file, not a per-role .env override.

# --- Silpo MCP -----------------------------------------------------------

# Streamable HTTP, OAuth 2.1 + PKCE + Dynamic Client Registration.
SILPO_MCP_URL=https://mcp.silpo.ua/mcp

# --- Web search ------------------------------------------------------------

TAVILY_API_KEY=
# DuckDuckGo fallback needs no key.

# --- Escalation ------------------------------------------------------------

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Skips the interactive confirmation prompt before a file write/Telegram
# send. Independent of ALLOW_REAL_SEND below.
# Accepted: true/false. Unset means false.
BYPASS_HITL=

# Permits an actual Telegram API call. Accepted: true/false. Unset means
# false — leave this off except when running
# scripts/escalation_agent_smoke.py deliberately.
ALLOW_REAL_SEND=

# --- Caches — kept off the system drive -----------------------------------

HF_HOME=.cache/hf
PIP_CACHE_DIR=.cache/pip
DEEPEVAL_HOME=.cache/deepeval
DEEPEVAL_TELEMETRY_OPT_OUT=YES

# --- Tracing -----------------------------------------------------------------

# This project's own switch, not a Langfuse variable. Accepted: true/false.
# Unset means false. `true` without both Langfuse keys below is refused at
# startup, not attempted — a refused request is easier to diagnose than a
# background exporter failing silently on every span.
TRACING_ENABLED=

# Langfuse Cloud — no self-hosted stack (v3 needs ~5.5 GB container memory,
# not available on this machine).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Names the prompt experiment this process serves, and the date it began.
# Both become Langfuse trace tags, so a prompt change is filterable as its
# own group under Scores > Analytics instead of blending into the baseline
# it is meant to be measured against. Unset means untagged baseline
# traffic — that default is deliberate, since a non-empty fallback would
# retroactively label ordinary traffic as an experiment.
EXPERIMENT=
EXPERIMENT_STARTED_AT=

# --- Frontend ------------------------------------------------------------

# CORS on src.interfaces.api is open only to this one origin (task §8).
# Default matches Vite's own default dev port — only set this if you run
# the frontend dev server on a different port.
FRONTEND_ORIGIN=
